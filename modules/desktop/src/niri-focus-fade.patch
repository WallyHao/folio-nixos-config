diff --git a/src/layout/focus_fade.rs b/src/layout/focus_fade.rs
new file mode 100644
index 0000000..01da3c8
--- /dev/null
+++ b/src/layout/focus_fade.rs
@@ -0,0 +1,131 @@
+//! A reversible opacity transition for focus rings, independent of window opacity.
+
+use crate::animation::{Animation, Clock, Curve};
+
+#[derive(Debug)]
+pub(super) struct FocusFade {
+    clock: Clock,
+    active: bool,
+    animation: Option<Animation>,
+}
+
+impl FocusFade {
+    pub(super) fn new(clock: Clock) -> Self {
+        Self {
+            clock,
+            active: false,
+            animation: None,
+        }
+    }
+
+    pub(super) fn update(&mut self, active: bool) {
+        if self.active == active {
+            return;
+        }
+        // Sample before changing the target so an interrupted fade never jumps.
+        let from = self.value();
+        self.active = active;
+        self.animation = Some(Animation::ease(
+            self.clock.clone(),
+            from,
+            if active { 1. } else { 0. },
+            0.,
+            300,
+            Curve::EaseOutCubic,
+        ));
+    }
+
+    pub(super) fn value(&self) -> f64 {
+        self.animation
+            .as_ref()
+            .map_or(if self.active { 1. } else { 0. }, |animation| {
+                animation.clamped_value().clamp(0., 1.)
+            })
+    }
+
+    pub(super) fn advance(&mut self) {
+        if self.animation.as_ref().is_some_and(Animation::is_done) {
+            self.animation = None;
+        }
+    }
+
+    pub(super) fn is_ongoing(&self) -> bool {
+        self.animation
+            .as_ref()
+            .is_some_and(|animation| !animation.is_done())
+    }
+
+    pub(super) fn is_fading_out(&self) -> bool {
+        !self.active && self.is_ongoing()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn fades_in_and_out_and_stops_requesting_frames() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let mut fade = FocusFade::new(clock.clone());
+        assert_eq!(fade.value(), 0.);
+        assert!(!fade.is_ongoing());
+        fade.update(true);
+        assert_eq!(fade.value(), 0.);
+        clock.set_unadjusted(Duration::from_millis(150));
+        assert!(fade.value() > 0. && fade.value() < 1.);
+        // Repeated render updates must not restart a transition.
+        fade.update(true);
+        clock.set_unadjusted(Duration::from_millis(300));
+        fade.advance();
+        assert_eq!(fade.value(), 1.);
+        assert!(!fade.is_ongoing());
+        fade.update(false);
+        assert!(fade.is_fading_out());
+        clock.set_unadjusted(Duration::from_millis(450));
+        assert!(fade.value() > 0. && fade.value() < 1.);
+        clock.set_unadjusted(Duration::from_millis(600));
+        fade.advance();
+        assert_eq!(fade.value(), 0.);
+        assert!(!fade.is_fading_out());
+        assert!(!fade.is_ongoing());
+    }
+
+    #[test]
+    fn rapid_focus_reversal_preserves_current_opacity() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let mut fade = FocusFade::new(clock.clone());
+        fade.update(true);
+        clock.set_unadjusted(Duration::from_millis(80));
+        let before = fade.value();
+        fade.update(false);
+        assert_eq!(fade.value(), before);
+        clock.set_unadjusted(Duration::from_millis(120));
+        assert!(fade.value() < before);
+        let before = fade.value();
+        fade.update(true);
+        assert_eq!(fade.value(), before);
+        clock.set_unadjusted(Duration::from_millis(420));
+        fade.advance();
+        assert_eq!(fade.value(), 1.);
+    }
+
+    #[test]
+    fn respects_global_animation_disable_and_slowdown() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let mut fade = FocusFade::new(clock.clone());
+        clock.set_rate(0.5);
+        fade.update(true);
+        clock.set_unadjusted(Duration::from_millis(300));
+        assert!(fade.value() > 0. && fade.value() < 1.);
+        clock.set_complete_instantly(true);
+        assert_eq!(fade.value(), 1.);
+        fade.advance();
+        assert!(!fade.is_ongoing());
+        fade.update(false);
+        assert_eq!(fade.value(), 0.);
+        fade.advance();
+        assert!(!fade.is_ongoing());
+    }
+}
