;;; Disposable runtime test -*- lexical-binding: t; -*-
(require 'ert)
(ert-deftest folio-menu-visibility ()
  (let ((original menu-bar-mode))
    (unwind-protect
        (progn
          (menu-bar-mode -1)
          (call-interactively (key-binding (kbd "C-c t m")))
          (should menu-bar-mode)
          (should (= 1 (frame-parameter nil 'menu-bar-lines)))
          (call-interactively (key-binding (kbd "C-c t m")))
          (should-not menu-bar-mode)
          (should (= 0 (frame-parameter nil 'menu-bar-lines))))
      (menu-bar-mode (if original 1 -1)))))
(ert-deftest folio-search-and-org-display ()
  (should vertico-mode)
  (should marginalia-mode)
  (should-not fido-mode)
  (should (executable-find "rg"))
  (should (executable-find "fd"))
  (let ((queried nil))
    (cl-letf (((symbol-function 'consult-ripgrep)
               (lambda (directory &rest _) (setq queried directory))))
      (folio-emacs-search-notes)
      (should (equal queried org-roam-directory))))
  (with-temp-buffer
    (org-mode)
    (insert "* Heading\nText with *emphasis*.\n| A | B |\n| 1 | 2 |\n#+begin_src shell\nprintf hello\n#+end_src\n")
    (font-lock-ensure)
    (should org-modern-mode)
    (should org-src-fontify-natively)
    (should org-startup-with-inline-images)
    (should (equal (key-binding (kbd "C-c s o")) #'consult-outline))
    (goto-char (point-min))
    (call-interactively (key-binding (kbd "C-c SPC")))
    (forward-char 3)
    (should (use-region-p))
    (should (equal (buffer-substring (region-beginning) (region-end)) "* H"))))
(ert-deftest folio-start-page ()
  (should doom-modeline-mode)
  (should (equal (key-binding (kbd "C-c n h")) #'dashboard-open))
  (let ((file (expand-file-name "recent-note.org" (getenv "HOME"))))
    (with-temp-file file (insert "* Recent note\n"))
    (let ((recentf-list (list file)))
      (save-window-excursion
        (dashboard-open)
        (with-current-buffer "*dashboard*"
          (should (derived-mode-p 'dashboard-mode))
          (should-not display-line-numbers-mode)
          (should (string-match-p "Find note" (buffer-string)))
          (should (string-match-p "recent-note.org" (buffer-string))))))))
(ert-deftest folio-start-page-empty-startup ()
  (let ((noninteractive nil)
        (opened nil))
    (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) nil))
              ((symbol-function 'dashboard-open) (lambda () (setq opened t))))
      (folio-emacs-start-page)
      (should opened))))
(ert-deftest folio-start-page-preserves-open-file ()
  (should (memq #'folio-emacs-start-page emacs-startup-hook))
  (let ((noninteractive nil))
    (save-window-excursion
      (with-temp-buffer
        (rename-buffer "explicit-file.org" t)
        (setq buffer-file-name (expand-file-name "explicit-file.org" (getenv "HOME")))
        (switch-to-buffer (current-buffer))
        (let ((document (current-buffer)))
          (folio-emacs-start-page)
          (should (eq document (current-buffer))))))))
(ert-deftest folio-document-interface ()
  (with-temp-buffer
    (rename-buffer "interface.org" t)
    (org-mode)
    (insert "* Notes\nFirst paragraph.\nSecond paragraph.\n")
    (should display-line-numbers-mode)
    (should (eq display-line-numbers-type t))
    (should hl-line-mode)
    (should visual-line-mode)
    (should tab-line-mode)
    (should (equal (key-binding (kbd "C-c n f")) #'org-roam-node-find)))
  (with-temp-buffer
    (help-mode)
    (should-not display-line-numbers-mode))
  (should which-key-mode)
  (should (lookup-key global-map [menu-bar Notes]))
  (dolist (file (list recentf-save-file savehist-file save-place-file))
    (should (file-in-directory-p file (getenv "XDG_STATE_HOME")))))
(ert-deftest folio-org-roam-links ()
  (should (sqlite-available-p))
  (should (equal (key-binding (kbd "C-c n b")) #'org-roam-buffer-toggle))
  (should (file-in-directory-p org-roam-db-location (getenv "HOME")))
  (let ((a (expand-file-name "folio.org" org-roam-directory))
        (b (expand-file-name "sysrepo.org" org-roam-directory)))
    (with-temp-file b
      (insert ":PROPERTIES:\n:ID: sysrepo-test\n:END:\n#+title: sysrepo\n\nConfiguration datastore.\n"))
    (with-temp-file a
      (insert ":PROPERTIES:\n:ID: folio-test\n:END:\n#+title: Folio\n\nUses [[id:sysrepo-test][sysrepo]] for configuration.\n"))
    (org-roam-db-sync)
    (should (= 2 (length (org-roam-node-list))))
    (let* ((node (org-roam-node-from-id "sysrepo-test"))
           (backlinks (org-roam-backlinks-get node)))
      (should (= 1 (length backlinks)))
      (should (equal "folio-test"
                     (org-roam-node-id (org-roam-backlink-source-node (car backlinks))))))
    (find-file b)
    (org-roam-buffer-toggle)
    (should (get-buffer "*org-roam*"))
    (kill-buffer)))
(ert-run-tests-batch-and-exit)
